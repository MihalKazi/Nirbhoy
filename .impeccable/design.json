      "description": "Red pill for emergency calls only.",
      "html": "<a class=\"ds-btn-red\" href=\"tel:999\">999 Police</a>",
      "css": ".ds-btn-red{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;border-radius:999px;background:#c62f3f;color:#fff;font-family:'Hind Siliguri',system-ui,sans-serif;font-size:1rem;font-weight:700;text-decoration:none}.ds-btn-red:hover{background:#a8242f}.ds-btn-red:focus-visible{outline:3px solid #6b46c1;outline-offset:2px}"
    },
    {
      "name": "Row",
      "kind": "card",
      "refersTo": "row-card",
      "description": "Signature card row: violet-soft icon circle, name, hint, data pill, chevron.",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-row-icon\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\"/></svg></span><span><span class=\"ds-row-name\">Someone shared my photos</span><span class=\"ds-row-hint\">Take them down and keep proof</span></span><span class=\"ds-row-data\">6 steps</span><svg class=\"ds-row-chev\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"/></svg></a>",
      "css": ".ds-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;align-items:center;gap:14px;padding:16px 16px 16px 14px;background:#fff;border:1px solid #ebe5f3;border-radius:20px;color:#2a1f3d;text-decoration:none;box-shadow:0 1px 2px rgba(42,31,61,.06);transition:border-color .15s,box-shadow .25s cubic-bezier(0.16,1,0.3,1),transform .25s cubic-bezier(0.16,1,0.3,1)}.ds-row:hover,.ds-row:focus-visible{border-color:#e2d8f3;box-shadow:0 1px 2px rgba(42,31,61,.05),0 10px 24px -14px rgba(84,51,153,.28);transform:translateY(-2px)}.ds-row:focus-visible{outline:3px solid #6b46c1;outline-offset:2px}.ds-row-icon{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:#ece4fb;color:#553399}.ds-row-name{display:block;font-family:'Hind Siliguri',system-ui,sans-serif;font-weight:700;font-size:1.0625rem;line-height:1.35}.ds-row-hint{display:block;margin-top:3px;font-size:.9375rem;color:#5b5170}.ds-row-data{font-size:.8125rem;font-weight:600;color:#553399;background:#ece4fb;border-radius:999px;padding:2px 10px;white-space:nowrap}.ds-row-chev{color:#5b5170}"
    },
    {
      "name": "Status Dot",
      "kind": "custom",
      "refersTo": "row-card",
      "description": "Empty ring (not started), dashed violet ring (in progress), filled green with tick (done).",
      "html": "<span class=\"ds-dot\"></span> <span class=\"ds-dot ds-dot-part\"></span> <span class=\"ds-dot ds-dot-on\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5 L10 18.5 L20 6\"/></svg></span>",
      "css": ".ds-dot{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;border:2px solid #e2d8f3;background:#fff;vertical-align:middle}.ds-dot-part{border-color:#6b46c1;border-style:dashed;background:#ece4fb}.ds-dot-on{background:#2e7d5b;border-color:#2e7d5b}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Lavender-white field; violet border and soft halo on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Date of incident\">",
      "css": ".ds-input{display:block;width:100%;min-height:50px;padding:12px 14px;font-family:'Hind Siliguri',system-ui,sans-serif;font-size:1rem;color:#2a1f3d;background:#faf7fd;border:1px solid #e2d8f3;border-radius:14px;caret-color:#6b46c1}.ds-input::placeholder{color:#8d84a0}.ds-input:focus-visible{outline:3px solid #ece4fb;outline-offset:0;border-color:#6b46c1;background:#fff}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "White pill; pressed fills violet.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">Police</button> <button class=\"ds-chip\" aria-pressed=\"false\">Legal aid</button>",
      "css": ".ds-chip{min-height:42px;padding:0 18px;border-radius:999px;border:1px solid #e2d8f3;background:#fff;color:#2a1f3d;font-family:'Hind Siliguri',system-ui,sans-serif;font-size:.9375rem;font-weight:600;cursor:pointer}.ds-chip[aria-pressed='true']{background:#6b46c1;border-color:#6b46c1;color:#fff}.ds-chip:hover:not([aria-pressed='true']){background:#efe8fa}.ds-chip:focus-visible{outline:3px solid #6b46c1;outline-offset:2px}"
    },
    {
      "name": "Nav Link",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Rail pill; lavender hover, violet-soft current page.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav\" href=\"#\" aria-current=\"page\">Home</a><a class=\"ds-nav\" href=\"#\">Save proof</a></nav>",
      "css": ".ds-rail{background:#fff;border:1px solid #ebe5f3;border-radius:20px;width:240px;padding:12px;display:grid;gap:2px}.ds-nav{display:flex;align-items:center;min-height:50px;padding:0 14px;border-radius:999px;color:#2a1f3d;text-decoration:none;font-family:'Hind Siliguri',system-ui,sans-serif;font-weight:600}.ds-nav:hover{background:#efe8fa}.ds-nav[aria-current='page']{background:#ece4fb;color:#553399}.ds-nav:focus-visible{outline:3px solid #6b46c1;outline-offset:2px}"
    },
    {
      "name": "Call Pair",
      "kind": "custom",
      "refersTo": "call-999",
      "description": "999 red pill beside a 109 violet-soft pill.",
      "html": "<div class=\"ds-calls\"><a class=\"ds-call ds-999\" href=\"tel:999\">999</a><a class=\"ds-call ds-109\" href=\"tel:109\">109</a></div>",
      "css": ".ds-calls{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:220px}.ds-call{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 18px;border-radius:999px;font-family:'Hind Siliguri',system-ui,sans-serif;font-weight:700;font-size:1.125rem;font-variant-numeric:tabular-nums;text-decoration:none}.ds-999{background:#c62f3f;color:#fff}.ds-999:hover{background:#a8242f}.ds-109{background:#ece4fb;color:#553399}.ds-109:hover{background:#6b46c1;color:#fff}.ds-call:focus-visible{outline:3px solid #6b46c1;outline-offset:2px}"
    },
    {
      "name": "Reassurance Pill",
      "kind": "chip",
      "refersTo": "reassure",
      "description": "Peach-cream pill with a terracotta heart.",
      "html": "<span class=\"ds-reassure\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z\"/></svg>This is not your fault, and you are not alone.</span>",
      "css": ".ds-reassure{display:inline-flex;align-items:center;gap:10px;padding:10px 16px;background:#fdf1ec;color:#2a1f3d;border-radius:999px;font-family:'Hind Siliguri',system-ui,sans-serif;font-size:.9375rem;font-weight:600}.ds-reassure svg{color:#c2573a;flex:none}"
    }
  ],
  "narrative": {
    "northStar": "Lavender Safe Room",
    "overview": "A warm, illustrated safe room drawn in lavender. The ground is a lavender-white wash; every surface on it is a white card with soft 20px corners, a lavender hairline and a faint violet-tinted shadow. The one thing that makes the room feel inhabited is drawing: hand-authored flat SVG scenes of faceless Bangladeshi women (warm brown skin, salwar kameez with orna, one in hijab) seated under an arch of light, with an alpana dot border tracing the arch, a shital pati mat underfoot, leaves at the edges and small four-point sparks standing in for light. Faces are left blank on purpose so any woman can see herself.\n\nThe interface around the drawings speaks softly and plainly. Violet is the working colour for anything she can do; peach carries warmth (the reassurance pill, the \"women only\" tag); green appears only when a step is done; red is held back for danger. Controls are pills, rows are cards, headings are bold but modest, and nothing is uppercased, condensed, taped, striped or boxed. Text size is hers to change: the whole rem scale rides a single `--scale` multiplier on `html` (1, 1.15, 1.3), persisted on the device.\n\nThis replaces the earlier \"Morning Tea Garden\" sage world, which the user rejected as too plain. Nothing of its mist-green palette, square-ish 12-16px radii or leaf-green action colour survives.",
    "keyCharacteristics": [
      "Lavender-white ground, white 20px cards with a 1px lavender hairline and a violet-tinted soft shadow.",
      "Violet for action, peach for warmth, green only for done, red only for danger and exit.",
      "Pill-shaped buttons, chips, nav links, call buttons and badges; circles for icons and status.",
      "Flat inline-SVG illustrations: faceless women, no outlines, glow and sparks for light, alpana dots, shital pati.",
      "One family (Hind Siliguri) in sentence case; Red Hat Mono for data only.",
      "User-controlled text scale (1 / 1.15 / 1.3) applied to the root font size."
    ],
    "rules": [
      {
        "name": "The Violet-Acts Rule",
        "body": "If she can press it, it is violet (or a white pill that fills lavender on hover). Violet is never decoration on non-interactive text.",
        "section": "colors"
      },
      {
        "name": "The Green-Means-Done Rule",
        "body": "Green appears only on a completed status dot and a verified result. It is never an action colour and never decoration.",
        "section": "colors"
      },
      {
        "name": "The Red-Is-Danger Rule",
        "body": "The red family marks danger, exit, prohibitions and failure only. It never marks a normal action, a heading or an ornament.",
        "section": "colors"
      },
      {
        "name": "The Shape-Before-Colour Rule",
        "body": "Status is never colour alone: an empty ring (not started), a dashed violet ring (in progress), a filled green circle with a white tick (done).",
        "section": "colors"
      },
      {
        "name": "The Sentence-Case Rule",
        "body": "Nothing is uppercased, letter-spaced or width-condensed. The `wdth` axis is loaded but unused.",
        "section": "typography"
      },
      {
        "name": "The Mono-Is-Data Rule",
        "body": "Red Hat Mono sets hashes, the GD draft and small technical captions only; never a name, heading, button or phone number.",
        "section": "typography"
      },
      {
        "name": "The Her-Scale Rule",
        "body": "Every size is in rem so the root `--scale` (1, 1.15, 1.3) enlarges the whole interface together. Never set type in px.",
        "section": "typography"
      },
      {
        "name": "The Soft-Lift Rule",
        "body": "Depth answers interaction: hover or open raises a card 2px and swaps resting for lifted. No hard offset shadows, no stacked borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every page on bg and every surface on paper with a 1px hairline and the resting shadow; round cards at 20px and inner containers at 14px.",
      "Do make every button, chip, nav link, call and badge a full pill (999px).",
      "Do use violet for anything she can act on, green only for done, and the red family only for danger, exit, prohibition and failure.",
      "Do carry status on shape (empty ring, dashed ring, filled circle with tick) before colour.",
      "Do draw new illustrations from the `C` palette: flat fills, no outlines, faceless figures, light as glow and sparks, the arch with alpana dots.",
      "Do size type in rem so the 1 / 1.15 / 1.3 text-size control scales everything."
    ],
    "donts": [
      "Don't bring back the rejected worlds: sage tea-garden greens, orange-and-black, stripes, cardboard, heavy borders or condensed caps.",
      "Don't use black or hard offset shadows; shadows are blurred and plum or violet tinted.",
      "Don't give illustrated figures faces, outlines, or stock-photo realism, and don't substitute raster images or icon glyphs for drawn scenes.",
      "Don't use red, or green, as a general emphasis or decoration colour.",
      "Don't put a decorative kicker above a heading; the small label style is only for live status lines and the back link.",
      "Don't set names, headings, buttons or phone numbers in Red Hat Mono."
    ],
    "knownGaps": [
      "Illustrations appear only on home (HeroArt), stories and the friend plan (TogetherArt). The other situation plans have no vignettes, and the proof shelf's empty state has no art, only a status line.",
      "The arch motif lives only inside the illustrations; no UI component (cards, panels, hero frame) uses the arch silhouette yet."
    ]
  }
}
